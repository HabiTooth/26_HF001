# EC2 서버의 /etc/habitooth/backend.env 로 복사해서 실제 값으로 채운다.
#   sudo cp backend.env.example /etc/habitooth/backend.env
#   sudo chmod 600 /etc/habitooth/backend.env
# 이 파일(example)에는 절대 실제 값을 넣지 않는다.

# RDS (MySQL)
DB_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/habitooth?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=admin
DB_PASSWORD=<RDS_PASSWORD>

# JWT  (생성: openssl rand -base64 48)
JWT_SECRET=<32글자이상_랜덤값>
JWT_EXPIRATION_MS=36000000

# SNS 로그인
KAKAO_CLIENT_ID=<값>
KAKAO_CLIENT_SECRET=<값>
GOOGLE_CLIENT_ID=<값>
GOOGLE_CLIENT_SECRET=<값>

# 외부 서버
AI_SERVER_BASE_URL=http://34.216.160.239:8000
LLM_SERVER_BASE_URL=https://scuba-chapter-drew.ngrok-free.dev

# 업로드 경로 (절대경로). FILE_STORAGE=local 일 때 사용
FILE_UPLOAD_DIR=/opt/habitooth/uploads

# 이미지 저장소 (local | s3)
#   s3 로 바꾸면 아래 S3_* 를 채우고, EC2 인스턴스 역할에 해당 버킷의 s3:GetObject / PutObject / DeleteObject 를 준다.
#   버킷은 퍼블릭 접근 차단 + 사진·오버레이 N일 후 삭제 수명 주기 규칙(예: 90일) 권장. 분석 수치는 DB 에 남는다.
#   기존 로컬 파일은 /opt/habitooth/uploads/ 아래 경로 그대로 버킷(S3_KEY_PREFIX 아래)에 올리면 DB 수정 없이 이어진다.
FILE_STORAGE=local
S3_BUCKET=<버킷명>
AWS_REGION=ap-northeast-2
S3_KEY_PREFIX=
S3_PRESIGN_TTL_SECONDS=300

# FastAPI report/generate 에 결과 오버레이 PNG 를 함께 요청할지 (구버전 FastAPI 는 필드를 무시)
AI_INCLUDE_OVERLAY=true
